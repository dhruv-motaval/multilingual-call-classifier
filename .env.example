# Groq API key -- used by init_chat_model("groq:...") for translation,
# classification, and the tool-calling action agent.
GROQ_API_KEY=

# Optional overrides (defaults shown)
GROQ_MODEL=groq:llama-3.3-70b-versatile
WHISPER_MODEL=medium

# Optional: turn on LangSmith tracing to watch the graph execute step by step
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-multiagent-call-classifier
